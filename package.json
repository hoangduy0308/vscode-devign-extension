{
  "name": "devign-vulnerability-scanner",
  "displayName": "Devign C/C++ Vulnerability Scanner",
  "description": "AI-powered vulnerability detection for C/C++ code using BiGRU deep learning model",
  "version": "1.0.0",
  "publisher": "devign",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "c",
    "cpp",
    "c++",
    "security",
    "vulnerability",
    "scanner",
    "devign",
    "deep learning"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**/*",
    "wasm/**/*",
    "python/**/*",
    "resources/**/*",
    "media/**/*",
    "webview-ui/dist/**/*",
    "node_modules/zod/**/*",
    "node_modules/web-tree-sitter/**/*",
    "node_modules/@vscode/codicons/**/*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devign",
          "title": "Devign Scanner",
          "icon": "resources/devign.svg"
        }
      ]
    },
    "views": {
      "devign": [
        {
          "type": "webview",
          "id": "devign.webview",
          "name": "Devign Scanner",
          "icon": "resources/devign.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "devign.scanCurrentFile",
        "title": "Devign: Scan Current File for Vulnerabilities",
        "icon": "$(play)"
      },
      {
        "command": "devign.scanWorkspace",
        "title": "Devign: Scan Workspace for Vulnerabilities",
        "icon": "$(folder)"
      },
      {
        "command": "devign.scanSelection",
        "title": "Devign: Scan Selected Code"
      },
      {
        "command": "devign.showResults",
        "title": "Devign: Show Scan Results"
      },
      {
        "command": "devign.clearDiagnostics",
        "title": "Devign: Clear All Diagnostics"
      },
      {
        "command": "devign.doctor",
        "title": "Devign: Run Doctor (Check Setup)"
      },
      {
        "command": "devign.openOutput",
        "title": "Devign: Open Output Log"
      },
      {
        "command": "devign.configurePython",
        "title": "Devign: Configure Python Path"
      },
      {
        "command": "devign.downloadModels",
        "title": "Devign: Download Models"
      },
      {
        "command": "devign.installDependencies",
        "title": "Devign: Install Dependencies",
        "icon": "$(package)"
      },
      {
        "command": "devign.clearCacheAndUpdate",
        "title": "Devign: Clear Cache & Update Models",
        "icon": "$(refresh)"
      },
      {
        "command": "devign.sidebar.refresh",
        "title": "Devign: Refresh Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "devign.revealResult",
        "title": "Devign: Go to Finding"
      },
      {
        "command": "devign.commitWithGate",
        "title": "Devign: Commit with Security Gate",
        "icon": "$(git-commit)"
      },
      {
        "command": "devign.pushWithGate",
        "title": "Devign: Push with Security Gate",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "devign.pullWithScan",
        "title": "Devign: Pull and Scan",
        "icon": "$(cloud-download)"
      },
      {
        "command": "devign.gate.run",
        "title": "Devign: Run Security Gate",
        "icon": "$(shield)"
      },
      {
        "command": "devign.gate.configure",
        "title": "Devign: Configure Security Gate",
        "icon": "$(gear)"
      },
      {
        "command": "devign.github.signIn",
        "title": "Devign: Sign In to GitHub",
        "icon": "$(github)"
      },
      {
        "command": "devign.github.signOut",
        "title": "Devign: Sign Out from GitHub",
        "icon": "$(sign-out)"
      },
      {
        "command": "devign.github.status",
        "title": "Devign: GitHub Status",
        "icon": "$(account)"
      },
      {
        "command": "devign.createPR",
        "title": "Devign: Create Pull Request with Scan Summary",
        "icon": "$(git-pull-request)"
      }
    ],
    "configuration": {
      "title": "Devign Vulnerability Scanner",
      "properties": {
        "devign.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable"
        },
        "devign.modelPath": {
          "type": "string",
          "default": "",
          "description": "Path to Devign model directory. Leave empty to auto-download from GitHub Releases."
        },
        "devign.autoDownloadModels": {
          "type": "boolean",
          "default": true,
          "description": "Automatically download models from GitHub Releases if not found locally"
        },
        "devign.threshold": {
          "type": "number",
          "default": 0.65,
          "minimum": 0,
          "maximum": 1,
          "description": "Vulnerability probability threshold (0.0 - 1.0). Optimal: 0.65"
        },
        "devign.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan C/C++ files on save"
        },
        "devign.scanOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan C/C++ files when opened"
        },
        "devign.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification popups for scan results"
        },
        "devign.maxFilesToScan": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of files to scan in workspace scan"
        },
        "devign.scannerScript": {
          "type": "string",
          "default": "",
          "description": "Path to vscode_scanner.py script (leave empty to use bundled script)"
        },
        "devign.device": {
          "type": "string",
          "enum": [
            "auto",
            "cpu",
            "cuda"
          ],
          "default": "auto",
          "description": "Device for inference (auto, cpu, cuda)"
        },
        "devign.scanTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 600,
          "description": "Timeout in seconds for scanning a single file"
        },
        "devign.gate.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable git gate policy to block/warn on vulnerabilities"
        },
        "devign.gate.onCommit": {
          "type": "boolean",
          "default": true,
          "description": "Run security gate before git commit"
        },
        "devign.gate.onPush": {
          "type": "boolean",
          "default": false,
          "description": "Run security gate before git push"
        },
        "devign.gate.scope": {
          "type": "string",
          "enum": [
            "staged",
            "staged+unstaged"
          ],
          "default": "staged",
          "enumDescriptions": [
            "Scan only staged files",
            "Scan both staged and unstaged modified files"
          ],
          "description": "Which files to include in security gate scan"
        },
        "devign.gate.blockOnRiskLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "default": [
            "CRITICAL",
            "HIGH"
          ],
          "description": "Risk levels that will block commit/push"
        },
        "devign.gate.blockThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Vulnerability probability threshold for blocking (0.0 - 1.0)"
        },
        "devign.gate.warnThreshold": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Vulnerability probability threshold for warnings (0.0 - 1.0)"
        },
        "devign.gate.maxCriticalFindings": {
          "type": "number",
          "default": 0,
          "minimum": -1,
          "description": "Maximum critical findings before blocking (-1 to disable)"
        },
        "devign.gate.maxHighFindings": {
          "type": "number",
          "default": 3,
          "minimum": -1,
          "description": "Maximum high severity findings before blocking (-1 to disable)"
        },
        "devign.gate.fallbackMode": {
          "type": "string",
          "enum": [
            "allow",
            "warn",
            "block"
          ],
          "default": "warn",
          "description": "Action when scan fails or times out"
        },
        "devign.gate.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 600,
          "description": "Gate scan timeout in seconds"
        },
        "devign.gate.allowedFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for files to skip during gate scanning"
        },
        "devign.gate.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/third_party/**",
            "**/vendor/**",
            "**/node_modules/**",
            "**/*.min.*"
          ],
          "description": "Glob patterns to exclude from gate scanning (applied after include patterns)"
        },
        "devign.gate.includeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.c",
            "**/*.cpp",
            "**/*.h",
            "**/*.hpp"
          ],
          "description": "Glob patterns to include in gate scanning (applied first, then exclude patterns filter out)"
        },
        "devign.gate.maxFilesToScan": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum files to scan in a single gate run. Prevents gate from hanging on large repos."
        },
        "devign.gate.maxFunctionsToScan": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 2000,
          "description": "Maximum functions to scan in a single gate run. Prevents gate from hanging on large repos."
        },
        "devign.gate.concurrentScans": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of concurrent file scans during gate execution."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "devign.scanCurrentFile",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "devign@1"
        },
        {
          "command": "devign.scanSelection",
          "when": "editorHasSelection && (resourceLangId == c || resourceLangId == cpp)",
          "group": "devign@2"
        }
      ],
      "explorer/context": [
        {
          "command": "devign.scanCurrentFile",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "devign@1"
        }
      ],
      "view/title": [
        {
          "command": "devign.scanCurrentFile",
          "when": "view == devign.webview",
          "group": "navigation@1"
        },
        {
          "command": "devign.scanWorkspace",
          "when": "view == devign.webview",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "devign.commitWithGate",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "devign.pushWithGate",
          "when": "scmProvider == git",
          "group": "navigation@2"
        },
        {
          "command": "devign.gate.run",
          "when": "scmProvider == git",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devign.scanCurrentFile",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "resourceLangId == c || resourceLangId == cpp"
      },
      {
        "command": "devign.commitWithGate",
        "key": "ctrl+shift+g c",
        "mac": "cmd+shift+g c"
      },
      {
        "command": "devign.pushWithGate",
        "key": "ctrl+shift+g p",
        "mac": "cmd+shift+g p"
      },
      {
        "command": "devign.gate.run",
        "key": "ctrl+shift+g r",
        "mac": "cmd+shift+g r"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha --ui tdd --reporter spec out/test/**/*.test.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/sinon": "^21.0.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoangduy0308/C-Vul-Devign"
  },
  "license": "MIT",
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "web-tree-sitter": "^0.26.3",
    "zod": "^4.2.1"
  }
}
